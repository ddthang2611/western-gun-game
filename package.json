{
  "name": "western-gun-game",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "setup": "npm install && npm --prefix client install",
    "build": "npm run client:build && tsc -p tsconfig.json && npm run db:seed",
    "start": "node dist/index.js --tunnel",
    "start:local": "node dist/index.js",
    "start:tunnel": "node dist/index.js --tunnel",
    "server:dev": "tsx watch server/index.ts",
    "server:tunnel": "tsx server/index.ts --tunnel",
    "server:start": "tsx server/index.ts",
    "db:seed": "tsx scripts/seed_db.ts",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "test": "tsx scripts/test_engine_comprehensive.ts"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
